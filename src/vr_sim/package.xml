<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vr_sim</name>
  <version>0.1.0</version>
  <description>Simulated Quest 3 and kinematic UR5 to run the VR registration and teleop pipeline in RViz without hardware.</description>
  <maintainer email="fw124@duke.edu">Felix Wang</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>interactive_markers</exec_depend>
  <exec_depend>vr_interfaces</exec_depend>
  <exec_depend>aruco_tag_mapper</exec_depend>
  <exec_depend>ur5_common</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <!-- optional: test_ur_kinematics compares fk with the real UR URDF when these are installed -->
  <test_depend>ur_description</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>handeye_publisher</name>
  <version>0.1.0</version>
  <description>Loads a saved hand-eye calibration and attaches the camera to the robot TF tree.</description>
  <maintainer email="fw124@duke.edu">Felix Wang</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>handeye_calibration</exec_depend>
  <exec_depend>ur5_common</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
